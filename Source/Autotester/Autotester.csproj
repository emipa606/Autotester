<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputPath>..\..\1.7\Assemblies</OutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>None</DebugType>
    <LangVersion>latest</LangVersion>
    <FileVersion>1.7.0</FileVersion>
    <AssemblyVersion>1.7</AssemblyVersion>
    <Product>Autotester</Product>
    <Copyright>© Mlie 2026 - MIT License</Copyright>
    <Nullable>warnings</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony">
      <Version>3.0.0-rc.2</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="Rimworld">
      <HintPath>..\..\..\..\..\..\common\RimWorld\Assembly-CSharp.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity">
      <HintPath>..\..\..\..\..\..\common\RimWorld\UnityStubs.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
	<Target Name="KillRimWorld" BeforeTargets="Clean;Build">
		<Exec Command="tasklist /FI &quot;IMAGENAME eq RimWorld.exe&quot; | find /I &quot;RimWorld.exe&quot; &gt;nul &amp;&amp; taskkill /F /IM RimWorld.exe" IgnoreExitCode="true" />
	</Target>
</Project>